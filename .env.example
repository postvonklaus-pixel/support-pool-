# --------------------------------------------------------------------------
# KI-Social-Media-Automation-System - Umgebungsvariablen
#
# Kopiere diese Datei nach ".env" und trage echte Werte ein.
# WICHTIG: Ohne diese Datei bzw. mit den Platzhalter-Werten laeuft das
# gesamte System automatisch im MOCK-Modus (siehe README "MOCK-Modi").
# --------------------------------------------------------------------------

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
LOG_DIR=logs

# Schuetzt app.py's "/admin"-Route (MRR/Beta-Tester/Feedback). Auf Railway
# unbedingt ueber die Variables-Tab setzen, nicht den Default nutzen!
ADMIN_PASSWORD=change-me-in-production

# OpenAI - Textgenerierung fuer Content, Kommentar-/DM-Antworten, Reports
# TODO: echten Key eintragen: https://platform.openai.com/api-keys
OPENAI_API_KEY=dein_key_hier

# Replicate - Bild-/Video-Generierung
# TODO: echten Token eintragen: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=dein_token_hier

# Buffer - automatisches Veroeffentlichen auf Social-Plattformen
# TODO: echten Access Token eintragen: https://buffer.com/developers/api
BUFFER_ACCESS_TOKEN=dein_token_hier

# Stripe - Zahlungen/Abos (im Testmodus mit sk_test_... Keys nutzen!)
# TODO: echte Test-Keys eintragen: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=dein_key_hier
STRIPE_WEBHOOK_SECRET=dein_webhook_hier

# Pinecone - Vektordatenbank (z.B. fuer Content-/Trend-Retrieval)
# TODO: echten Key eintragen: https://app.pinecone.io
PINECONE_API_KEY=dein_key_hier

# Datenbank (Postgres empfohlen fuer Produktion)
# Auskommentiert lassen fuer lokale Tests -> Fallback auf SQLite-Datei
# (./data/app.db), laeuft ohne jedes Setup. Fuer Postgres einkommentieren:
# DATABASE_URL=postgresql://user:pass@localhost/db

# Redis (Caching / Queues)
REDIS_URL=redis://localhost:6379

# E-Mail-Versand ueber Resend (https://resend.com), per HTTPS-API statt SMTP -
# SMTP-Ports werden von vielen PaaS-Hostern (u.a. Railway) blockiert.
# TODO: echten Key eintragen: https://resend.com/api-keys
RESEND_API_KEY=dein_key_hier
# Ohne eigene verifizierte Domain kann dieser Test-Absender bleiben:
RESEND_FROM_EMAIL=onboarding@resend.dev
# Reply-To: wohin "Antworten" auf unsere Mails gehen (muss per Cloudflare
# Email Routing o.ae. tatsaechlich an ein echtes Postfach weiterleiten)
REPLY_TO_EMAIL=support@autosocial.cc

# Webhook-/Production-Server (main.py, app.py, production.py)
# PORT wird von Heroku/Render/Railway automatisch gesetzt und hat Vorrang -
# lokal/production ohne diese Hosts greift WEBHOOK_PORT, Standard: 8080.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Abo-Logik
GRACE_PERIOD_DAYS=7

# MRR-Tracking: monatliches Umsatzziel fuer den taeglichen Alarm-Report
MRR_TARGET_MONTHLY=10000

# Langfristiges Wachstumsziel (Beta-Phase), siehe mrr.py: mrr_goal_progress()
MRR_GOAL_TARGET_USD=50000
MRR_GOAL_DAYS=90
# Festes Startdatum setzen (YYYY-MM-DD), sonst laeuft der Countdown bei
# jedem Neustart ab "heute" neu - fuer einen stabilen Countdown unbedingt
# auf das tatsaechliche Beta-Startdatum setzen!
MRR_GOAL_START_DATE=2026-08-05
